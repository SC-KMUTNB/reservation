{
  "name": "reservation-kmutnb",
  "version": "2.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "prisma generate && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "bun test tests",
    "seed": "bun run prisma/seed.ts",
    "db:ensure": "bun run scripts/ensure-db-schema.ts",
    "migrate:sheet": "bun run scripts/migrate-sheet.ts",
    "test:db": "bun run scripts/test-db.ts",
    "release": "bun run scripts/create-release.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "google-auth-library": "^11.3.1",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.2.12",
    "nodemailer": "^10.1.2",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.13.0",
    "lucide-svelte": "^1.0.1",
    "postcss": "^8.5.30",
    "prisma": "^6.4.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^8.3.4"
  }
}